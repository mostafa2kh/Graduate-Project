# =============================================================================
# RentSphere — Environment Variables Example
# =============================================================================
# Copy this file to .env and adjust values for your local environment.
# DO NOT commit the real .env file to Git.
# =============================================================================

# --- PostgreSQL Root ---
POSTGRES_USER=rentsphere
POSTGRES_PASSWORD=rentsphere
POSTGRES_DB=rentsphere_auth_db

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Redpanda (Kafka-compatible) ---
REDPANDA_BROKERS=localhost:9092
KAFKA_BROKERS=localhost:9092

# --- API Gateway ---
GATEWAY_PORT=8080

# --- Auth Service ---
AUTH_SERVICE_PORT=8081
AUTH_DB_NAME=rentsphere_auth_db

# --- User Service ---
USER_SERVICE_PORT=8082
USER_DB_NAME=rentsphere_user_db

# --- Listing Service ---
LISTING_SERVICE_PORT=8083
LISTING_DB_NAME=rentsphere_listing_db

# --- Media Service ---
MEDIA_SERVICE_PORT=8084
MEDIA_DB_NAME=rentsphere_media_db
MEDIA_STORAGE_PATH=./media-storage

# --- AI Review Service ---
AI_REVIEW_SERVICE_PORT=8085
AI_REVIEW_DB_NAME=rentsphere_ai_review_db

# --- Moderation Service ---
MODERATION_SERVICE_PORT=8086
MODERATION_DB_NAME=rentsphere_moderation_db

# --- Verification Service ---
VERIFICATION_SERVICE_PORT=8087
VERIFICATION_DB_NAME=rentsphere_verification_db

# --- Search Service ---
SEARCH_SERVICE_PORT=8088
SEARCH_DB_NAME=rentsphere_search_db

# --- Booking Service ---
BOOKING_SERVICE_PORT=8089
BOOKING_DB_NAME=rentsphere_booking_db

# --- Payment Service ---
PAYMENT_SERVICE_PORT=8090
PAYMENT_DB_NAME=rentsphere_payment_db

# --- Chat Service ---
CHAT_SERVICE_PORT=8091
CHAT_DB_NAME=rentsphere_chat_db

# --- Notification Service ---
NOTIFICATION_SERVICE_PORT=8092
NOTIFICATION_DB_NAME=rentsphere_notification_db

# --- Audit Service ---
AUDIT_SERVICE_PORT=8093
AUDIT_DB_NAME=rentsphere_audit_db

# --- JWT (placeholder — generate a real secret for production) ---
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ACCESS_TOKEN_MINUTES=30

# --- Angular ---
ANGULAR_PORT=4200

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Spring ---
SPRING_PROFILES_ACTIVE=local
